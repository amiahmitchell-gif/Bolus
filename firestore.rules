rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's log lives under its family code. Only someone who knows
    // the code can open it; nobody can list the codes.
    match /families/{code}/{document=**} {
      allow read, write: if request.auth != null && code.size() >= 8;
    }
  }
}
